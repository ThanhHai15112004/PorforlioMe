{
  "name": "web-portfolio-root",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -c \"cyan.bold,yellow.bold\" -n \"FE,BE\" \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "dev:fe": "npm run dev --workspace=frontend",
    "dev:be": "npm run dev --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
