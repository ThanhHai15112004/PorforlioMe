// Tệp cấu hình sơ đồ cơ sở dữ liệu Prisma
// Định nghĩa các bảng dữ liệu cho Portfolio (Supabase PostgreSQL Database)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Mẫu bảng Dự án (Project)
model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  content     String?
  techStack   String[]
  imageUrl    String?
  demoUrl     String?
  githubUrl   String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Mẫu bảng Tin nhắn liên hệ (ContactMessage)
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
