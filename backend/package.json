{
  "name": "web-portfolio-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "imports": {
    "#config/*": "./src/config/*",
    "#constants/*": "./src/constants/*",
    "#controllers/*": "./src/controllers/*",
    "#helpers/*": "./src/helpers/*",
    "#lang/*": "./src/lang/*",
    "#middlewares/*": "./src/middlewares/*",
    "#models/*": "./src/models/*",
    "#routes/*": "./src/routes/*",
    "#services/*": "./src/services/*",
    "#seeders/*": "./prisma/seeders/*"
  },
  "scripts": {
    "dev": "prisma generate --schema=prisma/schema.dev.prisma && node --watch src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma && prisma db seed --schema=prisma/schema.prisma",
    "db:push:dev": "prisma db push --schema=prisma/schema.dev.prisma && prisma db seed --schema=prisma/schema.dev.prisma",
    "db:check": "node prisma/scripts/db-check.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "app-root-path": "^3.1.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
