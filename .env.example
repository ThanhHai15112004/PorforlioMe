PORT=3000
NODE_ENV=development

# Cấu hình chuỗi kết nối MySQL Database
DATABASE_URL="mysql://root:password@localhost:3306/portfolio_db"

# Cấu hình bảo mật JWT Token cho Admin
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Mật khẩu khởi tạo tài khoản Admin ban đầu khi seed
ADMIN_INITIAL_PASSWORD="!Password@#123"

# URL kết nối API cho Frontend
VITE_API_URL="http://localhost:3000/api"
